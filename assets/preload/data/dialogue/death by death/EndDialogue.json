		},
		{
			"isCommand": false,
			"name": "seira",
			"expression": "",
			"string": "No need to be like that, I understood it was that disgusting blue-haired woman who stole my microphone, no need to cry-",
			"key": "ydEnd19",
			"side": "left"
		},
		{
			"isCommand": false,
			"name": "manuel",
			"expression": "sad",
			"string": "That's not the point...",
