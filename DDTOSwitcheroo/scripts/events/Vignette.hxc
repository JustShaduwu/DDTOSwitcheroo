import funkin.play.PlayState;
import funkin.play.event.ScriptedSongEvent;

import flixel.FlxSprite;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;


class VignetteEvent extends ScriptedSongEvent
{
    var vignette:FlxSprite = null;


    public function new()
    {
        super('VignetteEvent');
    }


    public override function handleEvent(
        data
    ):Void
    {
        if (
            PlayState.instance == null ||
            PlayState.instance.isMinimalMode
        )
        {
            return;
        }


        ensureVignette();
        var activation:Int = 1;

        if (
            data != null &&
            data.value != null &&
            data.value.activation != null
        )
        {
            activation =
                Std.int(
                    data.value.activation
                );
        }

var speed:Float = 1;

if (
    data != null &&
    data.value != null &&
    data.value.speed != null
)
{
    speed =
        Std.parseFloat(
            Std.string(
                data.value.speed
            )
        );

    if (Math.isNaN(speed))
        speed = 1;
}

speed = Math.max(0, speed);

switch (activation)
{
    case 0:
        hideVignette(speed);

    case 1:
        showVignette(speed);

    default:
        showVignette(speed);
}
    }


    function ensureVignette():Void
    {
        if (
            PlayState.instance == null ||
            vignette != null
        )
        {
            return;
        }


        vignette =
            new FlxSprite().loadGraphic(
                Paths.image(
                    'vignette'
                )
            );


        vignette.antialiasing =
            true;


        vignette.scrollFactor.set();


        vignette.alpha =
            0.001;


        vignette.visible =
            true;


        vignette.cameras =
        [
            PlayState.instance.camGame
        ];

        vignette.zIndex = 10000;

        vignette.setGraphicSize(
            Std.int(
                vignette.width
            )
        );


        vignette.updateHitbox();


        vignette.screenCenter();


        PlayState.instance.add(
            vignette
        );
        PlayState.instance.refresh();
    }


function showVignette(
    speed:Float
):Void
{
    if (vignette == null)
        return;

    FlxTween.cancelTweensOf(
        vignette
    );

    vignette.visible = true;

    FlxTween.tween(
        vignette,
        {
            alpha: 1
        },
        speed,
        {
            ease:
                FlxEase.sineOut
        }
    );
}


function hideVignette(
    speed:Float
):Void
{
    if (vignette == null)
        return;

    FlxTween.cancelTweensOf(
        vignette
    );

    FlxTween.tween(
        vignette,
        {
            alpha: 0.001
        },
        speed,
        {
            ease:
                FlxEase.sineOut
        }
    );
}


    function destroyVignette():Void
    {
        if (vignette == null)
            return;


        FlxTween.cancelTweensOf(
            vignette
        );


        if (PlayState.instance != null)
        {
            PlayState.instance.remove(
                vignette,
                true
            );
        }


        vignette.destroy();

        vignette =
            null;
    }


    public function onSongRetry(
        event
    ):Void
    {
        destroyVignette();
    }


    public function onStateChangeBegin(
        event
    ):Void
    {
        destroyVignette();
    }


public function getEventSchema()
{
    return [
        {
            name:
                'activation',

            title:
                'Mode',

            defaultValue:
                1,

            type:
                'enum',

            keys:
            [
                'Off' => 0,
                'On' => 1
            ]
        },

        {
            name:
                'speed',

            title:
                'Tween Speed',

            defaultValue:
                1.0,

            type:
                'float',

            step:
                0.1,

            min:
                0
        }
    ];
}


    public function getTitle():String
    {
        return 'Vignette';
    }
}
