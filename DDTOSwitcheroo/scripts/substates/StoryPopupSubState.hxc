package switcheroo.substates;

import StoryPopupCatalog;
import LanguageManager;
import funkin.ui.MusicBeatSubState;
import funkin.Paths;
import funkin.PlayerSettings;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.text.FlxText;
import openfl.display.BitmapData;
import openfl.geom.Rectangle;
import openfl.geom.Point;
import StringTools;

import funkin.play.PlayState;
import flixel.FlxCamera;

class StoryPopupSubState extends MusicBeatSubState
{
    public var allowClose:Bool = false;
    var messages:Array<Dynamic>;
    var messageIndex:Int = 0;
    var preview:Bool = false;
    var box:FlxSprite;
    var messageText:FlxText;
    var renderedMessage:FlxSprite;
    var italicRanges:Array<Dynamic> = [];
    var uiScale:Float;
    var ready:Bool = false;
    var inputDelay:Float = 0.2;

    public var onFinished:Void->Void = null;

public function new(
    messages:Array<Dynamic>,
    preview:Bool = false,
    ?onFinished:Void->Void
)
{
    super();
    this.messages = messages.copy();
    this.preview = preview;
    this.onFinished = onFinished;
}

function getPopupCamera():FlxCamera
{
    if (PlayState.instance != null)
        return PlayState.instance.camHUD;

    return FlxG.camera;
}
    public static function openPopup(host:Dynamic, key:String, preview:Bool = false):Bool
    {
        if (host == null || host.subState != null) return false;
        var queue = StoryPopupCatalog.pending(key, preview);
        if (queue.length == 0) return false;
        host.openSubState(new StoryPopupSubState(queue, preview));
        return true;
    }


override function create():Void
{
    super.create();

    persistentUpdate = false;

    var popupCamera = getPopupCamera();

    uiScale = Math.min(
        1.0,
        Math.min(
            FlxG.width / 820,
            FlxG.height / 400
        )
    );

    // Fondo semitransparente.
    var background = new FlxSprite().makeGraphic(
        FlxG.width,
        FlxG.height,
        0x88FFFFFF
    );

    background.cameras = [popupCamera];
    background.scrollFactor.set(0, 0);

    add(background);

    // Caja del popup.
    box = new FlxSprite();
    box.frames = Paths.getSparrowAtlas(
        'dokistory/popup'
    );

    for (style in ['normal', 'glitch', 'libitina'])
        box.animation.addByPrefix(
            style,
            style,
            24,
            false
        );

    box.cameras = [popupCamera];
    box.scrollFactor.set(0, 0);
    box.scale.set(uiScale, uiScale);

    add(box);

    // Texto del popup.
    messageText = new FlxText(
        0,
        0,
        560 * uiScale,
        '',
        28
    );

    messageText.cameras = [popupCamera];
    messageText.scrollFactor.set(0, 0);

    add(messageText);

    FlxG.mouse.visible = true;

    if (messages.length == 0)
    {
        allowClose = true;
        close();
        return;
    }

    showMessage();
}

    function showMessage():Void
    {
        var entry = messages[messageIndex];
        var style = entry.style == null ? 'normal' : Std.string(entry.style).toLowerCase();
        if (style == 'epiphany') style = 'glitch';
        if (style == 'access') style = 'libitina';
        if (['normal', 'glitch','libitina'].indexOf(style) < 0) style = 'normal';
        box.animation.play(style, true);
        box.updateHitbox();
        box.screenCenter();
        box.antialiasing = true;
        var dark:Bool = style == 'libitina';
        var font = style == 'libitina' ? 'Perfect DOS VGA 437 Win.ttf'  : "Aller_Rg.ttf";
        var fontSize:Int = Std.int(28 * uiScale);
        messageText.setFormat(Paths.font(font), fontSize, dark ? 0xFFFFFFFF : 0xFF000000, 'center');
        messageText.antialiasing = !dark;
        setMessageMarkup(LanguageManager.getTranslation(Std.string(entry.key), Std.string(entry.message)));
        while (messageText.height > 185 * uiScale && messageText.size > Std.int(14 * uiScale))
            messageText.size -= 1;
        messageText.x = (FlxG.width - messageText.width) / 2;
        messageText.y = box.y + 30 * uiScale + Math.max(0, (185 * uiScale - messageText.height) / 2);
        renderMessageItalics();
        inputDelay = 0.2;
        ready = false;
        FlxG.sound.play(Paths.sound('scrollMenu'));
    }

    function setMessageMarkup(source:String):Void
    {
        // Parse after translation; indexes refer to the text without markers.
        messageText.clearFormats();
        var input = StringTools.replace(source, '<N>', '\n');
        input = StringTools.replace(input, '<Q>', '"');
        var plain:String = '';
        italicRanges = [];
        var cursor:Int = 0;
        while (cursor < input.length)
        {
            var start = input.indexOf('<I>', cursor);
            if (start < 0) { plain += input.substr(cursor); break; }
            var end = input.indexOf('<I>', start + 3);
            if (end < 0) { plain += input.substr(cursor); break; }
            plain += input.substring(cursor, start);
            var rangeStart = plain.length;
            plain += input.substring(start + 3, end);
            if (plain.length > rangeStart) italicRanges.push({start: rangeStart, end: plain.length});
            cursor = end + 3;
        }
        messageText.text = plain;

    }

    function renderMessageItalics():Void
    {
        if (renderedMessage != null)
        {
            remove(renderedMessage, true);
            renderedMessage.destroy();
            renderedMessage = null;
        }
        messageText.visible = true;
        if (italicRanges.length == 0) return;

        // Render the normal layout first, then shear only the marked glyph runs.
        // This avoids the native embedded-font italic flag, which can be ignored.
        messageText.drawFrame(true);
        var source = messageText.pixels;
        if (source == null) return;
        var runs:Array<Dynamic> = [];
        for (range in italicRanges)
        {
            var run:Dynamic = null;
            for (i in range.start...range.end)
            {
                var bounds = messageText.textField.getCharBoundaries(i);
                if (bounds == null || bounds.width <= 0) continue;
                if (run == null || Math.abs(run.y - bounds.y) > 1)
                {
                    run = {x: bounds.x, y: bounds.y, right: bounds.right, bottom: bounds.bottom};
                    runs.push(run);
                }
                else
                {
                    run.right = Math.max(run.right, bounds.right);
                    run.bottom = Math.max(run.bottom, bounds.bottom);
                }
            }
        }
        var result = new BitmapData(source.width + 16, source.height, true, 0);
        result.copyPixels(source, source.rect, new Point());
        // Clear every run before compositing to avoid erasing an adjacent run.
        for (run in runs)
        {
            var left = Math.max(0, Math.floor(run.x));
            var top = Math.max(0, Math.floor(run.y));
            var width = Math.min(source.width - left, Math.ceil(run.right) - left);
            var height = Math.min(source.height - top, Math.ceil(run.bottom) - top);
            if (width > 0 && height > 0) result.fillRect(new Rectangle(left, top, width, height), 0);
        }
        for (run in runs)
        {
            var left = Math.max(0, Math.floor(run.x));
            var top = Math.max(0, Math.floor(run.y));
            var width = Math.min(source.width - left, Math.ceil(run.right) - left);
            var bottom = Math.min(source.height, Math.ceil(run.bottom));
            if (width <= 0) continue;
            for (y in top...bottom)
            {
                var shift = Math.round((bottom - y - 1) * 0.15);
                result.copyPixels(source, new Rectangle(left, y, width, 1),
                    new Point(left + shift, y), null, null, true);
            }
        }
renderedMessage = new FlxSprite(
    messageText.x,
    messageText.y
).loadGraphic(
    result,
    false,
    0,
    0,
    true
);

renderedMessage.cameras = [getPopupCamera()];
renderedMessage.scrollFactor.set(0, 0);
renderedMessage.antialiasing = messageText.antialiasing;

add(renderedMessage);
messageText.visible = false;
    }

    override function update(elapsed:Float):Void
    {
        super.update(elapsed);
        var controls = PlayerSettings.player1.controls;
        if (!ready)
        {
            inputDelay -= elapsed;
            if (inputDelay <= 0 && !FlxG.mouse.pressed && !controls.ACCEPT) ready = true;
            return;
        }
        var clickConfirm = FlxG.mouse.justPressed
            && FlxG.mouse.x >= box.x && FlxG.mouse.x <= box.x + box.width
            && FlxG.mouse.y >= box.y + 215 * uiScale && FlxG.mouse.y <= box.y + box.height;
        if (!controls.ACCEPT_P && !clickConfirm) return;
        if (!preview) StoryPopupCatalog.acceptChild(messages[messageIndex]);
        FlxG.sound.play(Paths.sound('confirmMenu'));

messageIndex++;

if (messageIndex >= messages.length)
{
    allowClose = true;

    var callback = onFinished;
    onFinished = null;

    // Primero ejecutar el callback.
    if (callback != null)
    {
        trace('[POPUP] Ejecutando callback');
        callback();
    }

    // Después cerrar el subestado.
    close();
}
else
{
    showMessage();
}

    }
}
