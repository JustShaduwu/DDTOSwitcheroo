import funkin.modding.module.Module;
import funkin.Paths;
import flixel.FlxSprite;
import flixel.graphics.FlxGraphic;
import openfl.display.BitmapData;
import openfl.geom.Matrix;

class GalleryThumbnailCache extends Module
{
    static var thumbnails:Array<Dynamic> = null;

    public function new() { super('GalleryThumbnailCache'); }

    public static function find(path:String):FlxGraphic
    {
        if (thumbnails == null) thumbnails = [];
        var key = Paths.image(path);
        for (entry in thumbnails)
            if (entry.key == key && entry.graphic.bitmap != null) return entry.graphic;
        return null;
    }

    public static function get(path:String):FlxGraphic
    {
        var cached = find(path);
        if (cached != null) return cached;
        var source = new FlxSprite();
        var bitmap:BitmapData = null;
        try
        {
            source.loadGraphic(Paths.image(path));
            // Double the desktop thumbnail size, for sharp rendering at larger resolutions.
            bitmap = new BitmapData(380, 214, true, 0xFF000000);
            var factor = Math.min(380.0 / source.frameWidth, 214.0 / source.frameHeight);
            var matrix = new Matrix();
            matrix.scale(factor, factor);
            matrix.translate((380 - source.frameWidth * factor) / 2, (214 - source.frameHeight * factor) / 2);
            bitmap.draw(source.pixels, matrix, null, null, null, true);
            var graphic = FlxGraphic.fromBitmapData(bitmap, false, 'switcheroo-thumbnail:' + Paths.image(path));
            graphic.persist = true;
            thumbnails.push({key: Paths.image(path), graphic: graphic});
            source.destroy();
            return graphic;
        }
        catch (error:Dynamic)
        {
            source.destroy();
            if (bitmap != null) bitmap.dispose();
            throw error;
        }
    }
}
