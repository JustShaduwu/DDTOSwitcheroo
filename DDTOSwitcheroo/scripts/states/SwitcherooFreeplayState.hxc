    function addButtons()
    {
songPlayback = new FlxSprite()
    .loadGraphic(Paths.image('freeplay/extra/preview'));

songPlayback.setGraphicSize(Std.int(songPlayback.width * 0.6));
songPlayback.updateHitbox();

songPlayback.x = FlxG.width - songPlayback.width - 10;
songPlayback.y = 10;

songPlayback.zIndex = 100;



add(songPlayback);


modifierMenu = new FlxSprite()
    .loadGraphic(Paths.image('freeplay/extra/modifiers'));

modifierMenu.setGraphicSize(Std.int(modifierMenu.width * 0.6));
modifierMenu.updateHitbox();

modifierMenu.x = FlxG.width - modifierMenu.width - 10;
modifierMenu.y = songPlayback.y + songPlayback.height + 10;
modifierMenu.antialiasing = true;
modifierMenu.zIndex = 101;

add(modifierMenu);
    }


    function playMenuMusic():Void
    {
        FunkinSound.playMusic(
            'gettinSwitched',
            {
                overrideExisting: true,
                restartTrack: false,
                persist: true
            }
        );
    }

function buildChartOptions(
    songId:String
):Array<Dynamic>
{
    var result:Array<Dynamic> = [];

   
    var song:Song =
        SongRegistry.instance.fetchEntry(
            songId,
            {
                variation:
                    Constants.DEFAULT_VARIATION
            }
        );

    if (song == null)
        return result;

   
    var variationIds:Array<String> =
        song.variations;

    if (
        variationIds == null ||
        variationIds.length == 0
    )
    {
        variationIds = [
            Constants.DEFAULT_VARIATION
        ];
    }

    for (variationId in variationIds)
    {
       
        var difficulties:Array<String> =
            song.listDifficulties(
                variationId,
                null,
                false,
                false
            );

        if (
            difficulties == null ||
            difficulties.length == 0
        )
        {
            continue;
        }

        for (difficultyId in difficulties)
        {
            addChartOption(
                result,
                difficultyId,
                variationId
            );
        }
    }

    return result;
}


function addChartOption(
    result:Array<Dynamic>,
    difficultyId:String,
    variationId:String
):Void
{
    if (
        difficultyId == null ||
        difficultyId == ''
    )
    {
        return;
    }

    for (existing in result)
    {
        if (
            existing.difficulty ==
                difficultyId &&
            existing.variation ==
                variationId
        )
        {
            return;
        }
    }

    result.push(
    {
        visualId:
            difficultyId,

        difficulty:
            difficultyId,

        variation:
            variationId,

        instrumental:
            getInstrumentalForVariation(
                variationId
            )
    });
}

function getInstrumentalForVariation(
    variationId:String
):String
{
    switch (variationId)
    {
        case 'pico':
            return 'pico';

        case 'erect' | 'nightmare':
            return 'erect';

       
        default:
            return '';
    }
}


    function loadFreeplayData():Bool
    {
        if (!Assets.exists(FREEPLAY_DATA_PATH))
        {
            trace(
                'No se encontró el Freeplay JSON: ' +
                FREEPLAY_DATA_PATH
            );

            return false;
        }

        try
        {
            menuData = Json.parse(
                Assets.getText(FREEPLAY_DATA_PATH)
            );
        }
        catch (error:Dynamic)
        {
            trace(
                'Error leyendo ' +
                FREEPLAY_DATA_PATH +
                ': ' +
                error
            );

            return false;
        }

        if (
            menuData == null ||
            menuData.pages == null ||
            menuData.pages.length == 0
        )
        {
            trace(
                'El Freeplay JSON no contiene páginas.'
            );

            return false;
        }

        return true;
    }

