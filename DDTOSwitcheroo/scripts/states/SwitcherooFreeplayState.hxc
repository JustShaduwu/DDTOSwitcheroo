    override function create():Void
    {
        super.create();
        SwitcherooDiscordRPC.showMenu('Freeplay');

        instance = this;


if (pendingStickers != null)
{
    var oldStickers:Array<StickerSprite> =
        pendingStickers;

    pendingStickers = null;

    var stickerSubState:StickerSubState =
        new StickerSubState(
        {
            oldStickers: oldStickers
        });

    persistentUpdate = true;
    persistentDraw = true;

    openSubState(stickerSubState);
    stickerSubState.degenStickers();
}

        persistentUpdate = true;
        persistentDraw = true;

        playMenuMusic();

        if (!loadFreeplayData())
        {
            trace('No fue posible construir DokiFreeplayState.');
            returnToMainMenu();
            return;
        }

        buildMenu();

        currentPage = clampIndex(
            rememberedPage,
