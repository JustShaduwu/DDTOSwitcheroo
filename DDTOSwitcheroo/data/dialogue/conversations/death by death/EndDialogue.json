			"isCommand": false,
			"name": "manuel",
			"expression": "sad",
			"string": "...",
			"key": "dbdEnd39",
			"side": "right"
                },
		{
			"isCommand": false,
			"name": "seira",
			"expression": "hmm",
			"string": "I know what I'm talking about. I've done a lot of bad things in my life.",
