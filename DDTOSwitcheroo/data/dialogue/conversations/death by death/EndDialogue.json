		{
			"isCommand": false,
			"name": "seira",
			"expression": "hmm",
			"string": "I've hurt a lot of people too, just like you said.",
			"key": "dbdEnd41",
			"side": "left"
                },
		{
			"isCommand": false,
			"name": "seira",
			"expression": "hmm",
			"string": "But I don't let those mistakes define me as a person, you know? Because I worked hard to make things the way they were before.",
			"key": "dbdEnd42",
			"side": "left"
                },
		{
			"isCommand": false,
			"name": "seira",
			"expression": "",
			"string": "Or even better.",
			"key": "dbdEnd43",
			"side": "left"
