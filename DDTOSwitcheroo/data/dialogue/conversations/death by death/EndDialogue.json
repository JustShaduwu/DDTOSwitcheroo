			"isCommand": false,
			"name": "seira",
			"expression": "",
			"string": "I know we fought earlier today, but look...You're not that bad. Not as bad as you think you are",
			"key": "dbdEnd36",
			"side": "left"
		},
		{
			"isCommand": false,
			"name": "seira",
			"expression": "",
			"string": "Everyone is back now, everyone's fine, so you don't need to keep dwelling on things from the past that have already been resolved.",
			"key": "dbdEnd37",
			"side": "left"
		},
