import funkin.play.character.MultiSparrowCharacter;
import funkin.play.character.CharacterType;
import funkin.play.PlayState;
import funkin.modding.module.ModuleHandler;
import funkin.play.GameOverSubState;

class AngryKaityCharacter extends MultiSparrowCharacter
{
    var normalScale:Float = 1.0;
    var hasNormalScale:Bool = false;

    var gameOverScale:Float = 1.0;


    function new()
    {
        super('kaity-angry');
    }


  override public function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    GameOverSubState.musicSuffix = '-switcheroo';
  }

   

    override public function setScale(
        scale:Null<Float>
    ):Void
    {
        super.setScale(
            scale
        );


       
        if (scale != null)
        {
            normalScale =
                scale;

            hasNormalScale =
                true;
        }
    }


    function onNoteHit(event:NoteScriptEvent)
    {
        
        switch(event.note.kind)
        {
            case "markov", "noanimation", "switcheroo":
                return;

            default:
                super.onNoteHit(event);
        }
    }


    override public function playSingAnimation(
        dir:NoteDirection,
        miss:Bool = false,
        ?suffix:String = ''
    ):Void
    {
        var missRecolor =
            ModuleHandler.getModule(
                'MissRecolor'
            );


        if (missRecolor != null)
        {
            miss =
                missRecolor.scriptCall(
                    'prepareSingAnimation',
                    [
                        this,
                        dir,
                        miss,
                        suffix
                    ]
                );
        }


        super.playSingAnimation(
            dir,
            miss,
            suffix
        );
    }


   

    override public function playAnimation(
        name:String,
        restart:Bool = false,
        ignoreOther:Bool = false,
        reversed:Bool = false
    ):Void
    {
        var missRecolor =
            ModuleHandler.getModule(
                'MissRecolor'
            );


        if (missRecolor != null)
        {
            missRecolor.scriptCall(
                'onPlayAnimation',
                [
                    this,
                    name
                ]
            );
        }


        super.playAnimation(
            name,
            restart,
            ignoreOther,
            reversed
        );


        switch (name)
        {
           
            case 'firstDeath', 'deathLoop', 'deathConfirm':

                scale.set(
                    gameOverScale,
                    gameOverScale
                );


            default:

                if (hasNormalScale)
                {
                    scale.set(
                        normalScale,
                        normalScale
                    );
                }
        }
    }
}