import funkin.play.character.SparrowCharacter;
import funkin.play.character.CharacterType;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;

class ManuelPixelCharacter extends SparrowCharacter
{
  function new()
  {
    super('manuel-pixel');
  }

    function ownsNote(noteData:Dynamic):Bool
    {
        return noteData != null &&
            ((!noteData.getMustHitNote() && characterType == CharacterType.DAD)
            || (noteData.getMustHitNote() && characterType == CharacterType.BF));
    }

    function onNoteHit(event:HitNoteScriptEvent)
    {
        if (event.eventCanceled || event.note == null || event.note.noteData == null) return;
        var note = event.note;
        
        if (characterType == CharacterType.DAD && note.noteData.getMustHitNote())
        {
            if (note.kind == 'switcheroo')
            {
                playAnimation('shoot', true, true);
                return;
            }
            if (note.kind == 'noanimation') return;
        }
        if (ownsNote(note.noteData) && note.kind == 'mom')
        {
            playSingAnimation(note.noteData.getDirection(), false, 'alt');
            return;
        }
        super.onNoteHit(event);
    }


function onNoteMiss(event:NoteScriptEvent)
{
    
    if (event.eventCanceled || event.note == null || event.note.noteData == null)
        return;

    if (!ownsNote(event.note.noteData)) return;

    var suffix:String =
        event.note.kind == 'mom'
            ? 'alt'
            : '';

    this.playSingAnimation(
        event.note.noteData.getDirection(),
        true,
        suffix
    );
}

    override public function playSingAnimation(
        dir:NoteDirection,
        miss:Bool = false,
        ?suffix:String = ''
    ):Void
    {

		holdTimer = 0;
		if (flipX) {
			if (dir == 0) {dir = 3;} else if (dir == 3) {dir = 0;}
		}

        var missRecolor =
            ModuleHandler.getModule(
                'MissRecolor'
            );
			

        if (missRecolor != null)
        {
            miss =
                missRecolor.scriptCall(
                    'prepareSingAnimation',
                    [
                        this,
                        dir,
                        miss,
                        suffix
                    ]
                );
        }

        super.playSingAnimation(
            dir,
            miss,
            suffix
        );
    }

    override public function playAnimation(
        name:String,
        restart:Bool = false,
        ignoreOther:Bool = false,
        reversed:Bool = false
    ):Void
    {
        var missRecolor =
            ModuleHandler.getModule(
                'MissRecolor'
            );

        if (missRecolor != null)
        {
            missRecolor.scriptCall(
                'onPlayAnimation',
                [
                    this,
                    name
                ]
            );
        }

        super.playAnimation(
            name,
            restart,
            ignoreOther,
            reversed
        );
    }
  	override function onAdd() {
		switch (PlayState.instance.currentSong.id.toLowerCase()) {
			case 'death-by-death' | 'dual-death':
				this.idleSuffix = '-alt';
		}
	}
}
