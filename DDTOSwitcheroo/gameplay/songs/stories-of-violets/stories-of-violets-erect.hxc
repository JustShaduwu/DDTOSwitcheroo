import flixel.tweens.FlxEase;
import funkin.graphics.FunkinSprite;
import flixel.tweens.FlxTween;
import funkin.play.PlayState;
import funkin.play.PlayStatePlaylist;
import funkin.play.song.Song;
import flixel.FlxSprite;

class StoriesOfVioletsErectSong extends Song
{
  var hasPlayedCutscene:Bool;
    var blackScreen:FlxSprite;

  public function new()
  {
    super('stories-of-violets', {
      variation: 'erect'
    });
  }
    public override function onCreate(event):Void
    {
        super.onCreate(event);


		blackScreen = new FlxSprite(-FlxG.width * FlxG.camera.zoom, -FlxG.height * FlxG.camera.zoom).makeGraphic(FlxG.width * 3, FlxG.height * 3, 0xFF000000);
		blackScreen.scrollFactor.set();
		blackScreen.alpha = 1;
		PlayState.instance.add(blackScreen);
    }

      public override function onSongRetry(event):Void
    {
        super.onSongRetry(event);

        blackScreen.alpha = 1;
    }
 
	function onStepHit(event:SongTimeScriptEvent):Void
		{	
			switch(event.step)
			{
				case 5:
					FlxTween.tween(blackScreen, {alpha: 0}, 2);
			}
		}
}
